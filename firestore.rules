rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives & Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email.lower() == 'brener91.bg@gmail.com' && 
             request.auth.token.email_verified == true; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprints
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && 
             data.category is string &&
             data.costPrice is number &&
             data.sellingPrice is number &&
             data.variations is list &&
             data.totalStock is number &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time);
    }

    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0 &&
             data.contact is string &&
             data.totalDebt is number &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time);
    }

    function isValidSale(data) {
      return data.items is list && data.items.size() > 0 &&
             data.total is number &&
             data.paymentMethod in ['Dinheiro', 'Cartão', 'Pix', 'Fiado'] &&
             data.status in ['Concluída', 'Pendente'] &&
             (data.get('createdAt', null) == null || data.createdAt == request.time);
    }

    function isValidTransaction(data) {
      return data.customerId is string &&
             data.amount is number &&
             data.type in ['payment', 'debt'] &&
             data.createdAt == request.time;
    }

    // Collections
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['name', 'category', 'costPrice', 'sellingPrice', 'variations', 'totalStock', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isAdmin() && isValidId(customerId) && isValidCustomer(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['totalDebt', 'updatedAt', 'name', 'contact'])
      );
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(saleId) && isValidSale(incoming());
      allow update: if isAdmin() && isValidId(saleId) && (
        // Action: Complete sale or minor update
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if isAdmin() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update, delete: if false; // Transactions are immutable records
    }
  }
}
