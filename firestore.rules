rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives & Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email.lower() == 'brener91.bg@gmail.com' && 
             request.auth.token.email_verified == true; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprints
    function isValidProduct(data) {
      return data.get('name', 'ok') is string && 
             data.get('category', 'ok') is string &&
             data.get('costPrice', 0) is number &&
             data.get('sellingPrice', 0) is number &&
             data.get('variations', []) is list &&
             data.get('totalStock', 0) is number &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time);
    }

    function isValidCustomer(data) {
      return data.get('name', 'ok') is string &&
             data.get('contact', 'ok') is string &&
             data.get('totalDebt', 0) is number &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time);
    }

    function isValidSale(data) {
      return data.get('items', [1]) is list && (data.get('items', [1]).size() > 0) &&
             data.get('total', 0) is number &&
             data.get('paymentMethod', 'Pix') in ['Dinheiro', 'Cartão', 'Pix', 'Fiado'] &&
             data.get('status', 'Concluída') in ['Concluída', 'Pendente'] &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidTransaction(data) {
      return (data.get('customerId', null) == null || data.customerId is string) &&
             data.get('amount', 0) is number &&
             data.get('type', 'payment') in ['payment', 'debt'] &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidShipment(data) {
      return data.trackingCode is string &&
             data.status is string &&
             data.items is list &&
             data.hasTax is bool &&
             data.taxAmount is number &&
             data.taxPaid is bool &&
             (data.get('supplierName', '') is string) &&
             (data.get('notes', '') is string) &&
             (data.get('history', []) is list) &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time);
    }

    // Collections
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['name', 'category', 'costPrice', 'sellingPrice', 'variations', 'totalStock', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(customerId) && isValidCustomer(incoming());
      allow update: if isAdmin() && isValidId(customerId) && isValidCustomer(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['totalDebt', 'updatedAt', 'name', 'contact'])
      );
      allow delete: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(saleId) && isValidSale(incoming());
      allow update: if isAdmin() && isValidId(saleId) && (
        // Action: Complete sale or minor update
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow list: if isAdmin();
      allow get: if isAdmin();
      allow create: if isAdmin() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update, delete: if false; // Transactions are immutable records
    }

    match /shipments/{shipmentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(shipmentId) && isValidShipment(incoming()) && 
                    (incoming().get('createdAt', null) == request.time);
      allow update: if isAdmin() && isValidId(shipmentId) && isValidShipment(incoming()) && (
        incoming().get('createdAt', null) == existing().get('createdAt', null) &&
        incoming().diff(existing()).affectedKeys().hasAny(['status', 'items', 'trackingCode', 'hasTax', 'taxAmount', 'taxPaid', 'notes', 'updatedAt', 'supplierName', 'history'])
      );
      allow delete: if isAdmin();
    }
  }
}
