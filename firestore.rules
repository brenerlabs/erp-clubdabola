rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives & Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function isAdmin() { 
      return isSignedIn() && 
             (request.auth.token.email.lower() == 'brener91.bg@gmail.com'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprints
    function isValidProduct(data) {
      return data.get('name', 'ok') is string && 
             data.get('category', 'ok') is string &&
             data.get('costPrice', 0) is number &&
             data.get('sellingPrice', 0) is number &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    function isValidCustomer(data) {
      return data.get('name', 'ok') is string &&
             data.get('contact', 'ok') is string &&
             data.get('totalDebt', 0) is number &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    function isValidSale(data) {
      return data.get('items', [1]) is list && (data.get('items', [1]).size() > 0) &&
             data.get('total', 0) is number &&
             data.get('paymentMethod', 'Pix') in ['Dinheiro', 'Cartão', 'Pix', 'Fiado'] &&
             data.get('status', 'Concluída') in ['Concluída', 'Pendente'] &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidTransaction(data) {
      return (data.get('customerId', null) == null || data.customerId is string) &&
             data.get('amount', 0) is number &&
             data.get('type', 'payment') in ['payment', 'debt'] &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    function isValidShipment(data) {
      return data.trackingCode is string &&
             data.status is string &&
             data.items is list &&
             data.hasTax is bool &&
             data.taxAmount is number &&
             data.taxPaid is bool &&
             (data.get('supplierName', '') is string) &&
             (data.get('notes', '') is string) &&
             (data.get('history', []) is list) &&
             (data.get('updatedAt', null) == null || data.updatedAt == request.time);
    }

    function isValidExpense(data) {
      return data.description is string && data.description.size() <= 200 &&
             data.amount is number &&
             data.category in ["Marketing/Ads", "Plataforma/Sistemas", "Embalagens", "Aluguel/Estrutura", "Logística Extra", "Outros"] &&
             (data.get('createdAt', null) == null || data.createdAt is timestamp || data.createdAt == request.time);
    }

    // Collections
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, write: if isAdmin();
    }

    match /compensations/{compensationId} {
      allow read, write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if (settingId == 'appearance') || isSignedIn();
      allow write: if isAdmin();
    }

    match /customer_photos/{photoId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
