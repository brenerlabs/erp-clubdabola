{
  "entities": {
    "Product": {
      "title": "Produto",
      "description": "Cadastro de produtos com suporte a grade e preços.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Nome do produto" },
        "category": { "type": "string", "description": "Categoria do produto" },
        "costPrice": { "type": "number", "description": "Preço de custo" },
        "sellingPrice": { "type": "number", "description": "Preço de venda" },
        "margin": { "type": "number", "description": "Margem de lucro em %" },
        "markup": { "type": "number", "description": "Markup em %" },
        "variations": {
          "type": "array",
          "description": "Grade de variações (cor, tamanho, estoque)"
        },
        "totalStock": { "type": "number", "description": "Estoque total acumulado" },
        "minStock": { "type": "number", "description": "Estoque mínimo para alerta" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "costPrice", "sellingPrice"]
    },
    "Customer": {
      "title": "Cliente",
      "description": "Cadastro de clientes e saldo devedor (Fiado).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Nome do cliente" },
        "contact": { "type": "string", "description": "Telefone/WhatsApp" },
        "totalDebt": { "type": "number", "description": "Saldo devedor total" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Sale": {
      "title": "Venda",
      "description": "Registro de vendas realizadas no PDV.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "description": "ID do cliente (opcional)" },
        "customerName": { "type": "string", "description": "Nome do cliente para busca rápida" },
        "items": { "type": "array", "description": "Itens vendidos" },
        "total": { "type": "number", "description": "Valor total da venda" },
        "paymentMethod": { "type": "string", "enum": ["Dinheiro", "Cartão", "Pix", "Fiado"] },
        "status": { "type": "string", "enum": ["Concluída", "Pendente"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "total", "paymentMethod"]
    },
    "Transaction": {
      "title": "Movimentação Financeira",
      "description": "Pagamentos de fiado ou outras entradas/saídas.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "description": "ID do cliente associado" },
        "amount": { "type": "number", "description": "Valor da transação" },
        "type": { "type": "string", "enum": ["payment", "debt"], "description": "Tipo de movimentação" },
        "paymentMethod": { "type": "string", "description": "Forma de pagamento (Pix, Dinheiro, etc)" },
        "saleId": { "type": "string", "description": "ID da venda associada (se aplicável)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação" }
      },
      "required": ["customerId", "amount", "type"]
    },
    "Shipment": {
      "title": "Encomenda / Importação",
      "description": "Agrupamento de pedidos para importação e rastreio.",
      "type": "object",
      "properties": {
        "trackingCode": { "type": "string", "description": "Código de rastreio internacional" },
        "status": { "type": "string", "description": "Status da encomenda" },
        "items": { "type": "array", "description": "Lista de itens e clientes no lote" },
        "hasTax": { "type": "boolean", "description": "Se houve taxação" },
        "taxAmount": { "type": "number", "description": "Valor da taxa paga" },
        "taxPaid": { "type": "boolean", "description": "Se a taxa foi liquidada" },
        "supplierName": { "type": "string", "description": "Nome do fornecedor" },
        "notes": { "type": "string", "description": "Observações adicionais" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["trackingCode", "status", "items"]
    },
    "Expense": {
      "title": "Despesa Operacional",
      "description": "Despesas fixas ou variáveis do ecossistema Club da Bola.",
      "type": "object",
      "properties": {
        "description": { "type": "string", "description": "Descrição da despesa" },
        "amount": { "type": "number", "description": "Valor monetário da despesa" },
        "category": { "type": "string", "enum": ["Marketing/Ads", "Plataforma/Sistemas", "Embalagens", "Aluguel/Estrutura", "Logística Extra", "Outros"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "category"]
    },
    "Coupon": {
      "title": "Cupom de Desconto",
      "description": "Cupons de desconto para o catálogo público.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Código do cupom" },
        "type": { "type": "string", "enum": ["percentage", "fixed"], "description": "Tipo de desconto" },
        "value": { "type": "number", "description": "Valor do desconto (R$ ou %)" },
        "minPurchase": { "type": "number", "description": "Compra mínima exigida" },
        "isActive": { "type": "boolean", "description": "Se o cupom está ativo" },
        "expiresAt": { "type": "string", "description": "Data de validade YYYY-MM-DD" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação" }
      },
      "required": ["code", "type", "value", "isActive"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Coleção de produtos"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Coleção de clientes"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Histórico de vendas"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Movimentações de fiado"
    },
    "/shipments/{shipmentId}": {
      "schema": "Shipment",
      "description": "Lotes de importação"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Despesas operacionais e custos fixos"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Cupons de desconto promocionais"
    }
  }
}
